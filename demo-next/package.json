{
  "name": "platform-components-demo-next",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js distribution demo for @infoplaza/platform. Mirrors the Vite demo but bundles the map page and the /api/platform/* catch-all auth handler into a single Next.js app.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-workers.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-workers.mjs && npm run build --prefix ..",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@infoplaza/platform": "file:..",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "22.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
